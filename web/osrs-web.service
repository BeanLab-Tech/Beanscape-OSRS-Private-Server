[Unit]
Description=BeanLab OSRS Web (OAuth registration)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rsmod
WorkingDirectory=/opt/osrs/web
EnvironmentFile=/opt/osrs/web/env
ExecStart=/opt/osrs/web/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8085
Restart=on-failure
RestartSec=3
# the game server holds the sqlite db; web is a short-living writer
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
