[Unit]
Description=BeanLab OSRS Admin Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/osrs/web
ExecStart=/opt/osrs/web/venv/bin/uvicorn admin_app:app --host 0.0.0.0 --port 8086
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
